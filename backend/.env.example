# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Configuration  
JWT_SECRET=your_jwt_secret_min_32_characters_long_change_this
JWT_EXPIRY=24h

# Gmail SMTP for Email Notifications
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_from_google

# Manager Email Notifications (comma-separated list)
MANAGER_EMAILS=admin@example.com

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Server Configuration
PORT=8000
DENO_ENV=development

# Bootstrap Admin Account (Created automatically on first run)
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=YourSecurePassword123!

# Frontend Manager URL (for invitation emails)
FRONTEND_MANAGER_URL=http://localhost:5174
