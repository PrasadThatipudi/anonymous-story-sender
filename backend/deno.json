{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-ffi --watch --allow-sys src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-ffi --allow-sys src/main.ts",
    "migrate": "deno run -A npm:prisma migrate dev --schema=src/infrastructure/database/prisma/schema.prisma",
    "generate": "deno run -A npm:prisma generate --schema=src/infrastructure/database/prisma/schema.prisma",
    "studio": "deno run -A npm:prisma studio --schema=src/infrastructure/database/prisma/schema.prisma",
    "test": "deno test --allow-all"
  },
  "imports": {
    "hono": "https://deno.land/x/hono@v4.0.10/mod.ts",
    "hono/": "https://deno.land/x/hono@v4.0.10/",
    "zod": "https://deno.land/x/zod@v3.22.4/mod.ts",
    "bcrypt": "npm:bcryptjs@^2.4.3",
    "@prisma/client": "npm:@prisma/client@^5.8.0",
    "prisma": "npm:prisma@^5.8.0",
    "djwt": "https://deno.land/x/djwt@v3.0.1/mod.ts",
    "nodemailer": "npm:nodemailer@^6.9.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom"
    ],
    "allowJs": false,
    "checkJs": false
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "nodeModulesDir": "auto"
}